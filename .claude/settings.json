{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(rustup show *)",
      "Bash(reuse lint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge origin/main *)",
      "Bash(git switch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(git branch --show-current *)",
      "Bash(git rev-parse *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh api repos/nebulaw/livspeil/actions/*)",
      "Bash(gh api repos/nebulaw/livspeil/commits/*)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(df *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -c push.negotiate=true push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(git worktree remove *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
