// The Phase 0 acceptance scene: one simulated day drives a lamp and the
// window light. `day_seconds.b` is the speed-up (simulated seconds per real
// second): 8640 turns 10 s (600 frames at 60 fps) into a full day.
// `time_of_day.offset` is the start time in hours (06:00).
//
// clock.time -> day_seconds -> time_of_day.hour -> sun (window light)
//                                               -> sunrise - sunset = daylight
// daylight -> lamp_color (night blue, warm, daylight) and lamp_intensity

room "Sun and Lamp" format=1 min-tier="T1" {
  network "/" {
    node "clock" type="core.time.clock@1" id="0192f5a0-7c3e-7a10-8000-000000000001"
    node "day_seconds" type="core.math.mul@1" id="0192f5a0-7c3e-7a10-8000-000000000002" {
      input "b" 8640.0
    }
    node "time_of_day" type="core.time.timeofday@1" id="0192f5a0-7c3e-7a10-8000-000000000003" {
      input "offset" 6.0
    }
    node "sun" type="core.sky.sun_direction@1" id="0192f5a0-7c3e-7a10-8000-000000000004" {
      input "day_of_year" 172.0
      input "latitude" 41.7
    }
    node "sunrise" type="core.math.smoothstep@1" id="0192f5a0-7c3e-7a10-8000-000000000005" {
      input "edge0" 5.0
      input "edge1" 8.0
    }
    node "sunset" type="core.math.smoothstep@1" id="0192f5a0-7c3e-7a10-8000-000000000006" {
      input "edge0" 17.0
      input "edge1" 20.0
    }
    node "daylight" type="core.math.sub@1" id="0192f5a0-7c3e-7a10-8000-000000000007"
    node "lamp_color" type="core.color.gradient@1" id="0192f5a0-7c3e-7a10-8000-000000000008" {
      input "c0" (color)"oklch(0.35 0.08 260.0 1.0)"
      input "c1" (color)"oklch(0.78 0.14 60.0 1.0)"
      input "c2" (color)"oklch(0.95 0.03 95.0 1.0)"
      input "p1" 0.4
    }
    node "lamp_intensity" type="core.math.remap@1" id="0192f5a0-7c3e-7a10-8000-000000000009" {
      input "clamp" #true
      input "out_max" 0.2
      input "out_min" 1.0
    }
    link from="clock.time" to="day_seconds.a"
    link from="day_seconds.out" to="time_of_day.seconds"
    link from="daylight.out" to="lamp_color.t"
    link from="daylight.out" to="lamp_intensity.x"
    link from="sunrise.out" to="daylight.a"
    link from="sunset.out" to="daylight.b"
    link from="time_of_day.hour" to="sun.solar_hour"
    link from="time_of_day.hour" to="sunrise.x"
    link from="time_of_day.hour" to="sunset.x"
  }
  meta {
    node "clock" x=0.0 y=120.0
    node "day_seconds" x=200.0 y=120.0
    node "daylight" x=800.0 y=200.0
    node "lamp_color" x=1000.0 y=160.0
    node "lamp_intensity" x=1000.0 y=280.0
    node "sun" x=600.0 y=0.0
    node "sunrise" x=600.0 y=140.0
    node "sunset" x=600.0 y=260.0
    node "time_of_day" x=400.0 y=120.0
  }
}
