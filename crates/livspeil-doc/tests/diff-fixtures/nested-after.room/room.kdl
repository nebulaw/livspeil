// Diff fixture: subnets, Charm metadata, tables and curves (see
// nested-before.room for the other side).

room "Nested After" format=1 min-tier="T2" {
  network "/" {
    node "sun" type="core.time.timeofday@1" id="01930000-0000-7000-8000-000000000001"
    node "lamp" type="core.subnet@1" id="01930000-0000-7000-8000-000000000010" {
      charm "Glow" version="1.1.0" min-tier="T2" {
        capability "time"
        capability "net"
      }
      network {
        node "bias" type="core.math.add@1" id="01930000-0000-7000-8000-000000000002" {
          input "b" 0.1
        }
        node "hour" type="core.subnet.input@1" id="01930000-0000-7000-8000-000000000011" port-type="Int" {
          input "value" 12
        }
        node "dawn" type="core.math.smoothstep@1" id="01930000-0000-7000-8000-000000000012" {
          input "edge0" 5.0
          input "edge1" 8.0
        }
        node "level" type="core.output@1" id="01930000-0000-7000-8000-000000000014" port-type="Float"
        link from="bias.out" to="level.value"
        link from="dawn.out" to="bias.a"
        link from="hour.value" to="dawn.x"
      }
    }
    node "scale" type="core.math.mul@1" id="01930000-0000-7000-8000-000000000013" {
      input "b" 2.0
    }
    node "palette" type="core.table.sort@1" id="01930000-0000-7000-8000-000000000020" {
      input "table" {
        table {
          column "name" type="String"
          column "weight" type="Float"
          row "a" 1.0
          row "b" 2.5
          row "c" 3.0
          row "d" 4.0
        }
      }
    }
    node "big" type="core.table.count@1" id="01930000-0000-7000-8000-000000000021" {
      input "table" {
        table {
          column "x" type="Int"
          column "y" type="Int"
          row 100 0
          row 101 3
          row 102 6
          row 103 9
          row 104 12
          row 105 15
          row 106 18
          row 107 21
          row 108 24
          row 109 27
          row 110 30
          row 111 33
        }
      }
    }
    node "ramp" type="core.curve.ramp@1" id="01930000-0000-7000-8000-000000000022" {
      input "curve" {
        curve {
          key 0.0 0.0
          key 0.5 0.8 interp="step"
          key 0.75 0.5
          key 1.0 0.0
        }
      }
    }
    node "fade" type="core.curve.ramp@1" id="01930000-0000-7000-8000-000000000023"
    node "fx" type="core.subnet@1" id="01930000-0000-7000-8000-000000000030" {
      charm "Sparkle" version="0.1.0" {
        capability "gpu"
      }
      network {
        node "amount" type="core.subnet.input@1" id="01930000-0000-7000-8000-000000000031" port-type="Float" {
          input "value" 0.5
        }
      }
    }
    link from="lamp.level" to="scale.a"
  }
  meta {
    node "lamp" x=0.0 y=0.0
    node "lamp/dawn" x=15.0 y=20.0
  }
}
